<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    tools:context=".AddTaskActivity">

    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="24dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="TAMBAH TUGAS"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="24dp"
                android:drawableStart="@android:drawable/presence_online"
                android:drawablePadding="8dp"
                app:drawableTint="@color/primaryColor" />

            <EditText
                android:id="@+id/et_task_name"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_glass_card"
                android:backgroundTint="#F8F9FA"
                android:hint="Nama Tugas"
                android:paddingHorizontal="20dp"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/et_matkul"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_glass_card"
                android:backgroundTint="#F8F9FA"
                android:hint="Mata Kuliah"
                android:paddingHorizontal="20dp"
                android:textSize="14sp" />

            <EditText
                android:id="@+id/et_task_desc"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginBottom="24dp"
                android:background="@drawable/bg_glass_card"
                android:backgroundTint="#F8F9FA"
                android:hint="mm/dd/yyyy --:--"
                android:paddingHorizontal="20dp"
                android:textSize="14sp"
                android:drawableEnd="@android:drawable/ic_menu_my_calendar" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btn_save_task"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="SIMPAN TUGAS"
                android:textStyle="bold"
                app:cornerRadius="16dp"
                android:backgroundTint="@color/primaryColor" />

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>